# === Обязательное ===
TELEGRAM_BOT_TOKEN=

# === Владелец (необязательно) ===
# Доступ к /stats и работа без личного ключа. Свой id — у @userinfobot.
# Пусто или 0 — владельца нет, все пользователи равны.
OWNER_USER_ID=

# Резервный ключ владельца. Остальные пользователи приносят свой через /apikey.
GOOGLE_API_KEY=

# 2.5-pro на free tier имеет квоту 0, 2.5-flash закрыт для новых проектов.
GEMINI_MODEL=gemini-3.6-flash

# Мастер-секрет для шифрования чужих ключей в БД.
# Пусто — выводится из TELEGRAM_BOT_TOKEN. Смена токена делает сохранённые
# ключи нечитаемыми, и пользователям придётся ввести их заново.
ENCRYPTION_KEY=

# Этап 2 — DeepSeek и Kimi через openai SDK. Раскомментировать при включении.
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# Этап 5 — резерв, по умолчанию выключены.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

ENABLED_PROVIDERS=gemini
DEFAULT_LLM_PROVIDER=gemini

MAX_CONCURRENT_AGENTS=2
MAX_PHOTOS_PER_ANALYSIS=3

DATABASE_URL=sqlite+aiosqlite:///./stylist_bot.db
LOG_LEVEL=INFO
