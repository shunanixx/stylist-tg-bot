# === Обязательное ===
TELEGRAM_BOT_TOKEN=

# === Владелец (необязательно) ===
# Доступ к /stats и работа без личного ключа. Свой id — у @userinfobot.
# Пусто или 0 — владельца нет, все пользователи равны.
OWNER_USER_ID=

# Резервный ключ владельца. Остальные пользователи приносят свой через /apikey.
GOOGLE_API_KEY=

# 2.5-pro на free tier имеет квоту 0, 2.5-flash закрыт для новых проектов.
GEMINI_MODEL=gemini-3.6-flash

# Мастер-секрет для шифрования чужих ключей в БД.
# Пусто — выводится из TELEGRAM_BOT_TOKEN. Смена токена делает сохранённые
# ключи нечитаемыми, и пользователям придётся ввести их заново.
ENCRYPTION_KEY=

# Этап 2 — DeepSeek и Kimi через openai SDK. Раскомментировать при включении.
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# Этап 5 — резерв, по умолчанию выключены.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

ENABLED_PROVIDERS=gemini
DEFAULT_LLM_PROVIDER=gemini

MAX_CONCURRENT_AGENTS=2
MAX_PHOTOS_PER_ANALYSIS=3

DATABASE_URL=sqlite+aiosqlite:///./stylist_bot.db
LOG_LEVEL=INFO

# === Деплой (локально ничего из этого не нужно) ===
# polling — локально и на любом хосте, где процесс живёт всегда.
# webhook — на бесплатных PaaS: там сервис обязан слушать HTTP-порт.
RUN_MODE=polling

# Внешний https-адрес сервиса. На Render не задавать: бот берёт
# RENDER_EXTERNAL_URL, который платформа подставляет сама.
# WEBHOOK_BASE_URL=https://имя-сервиса.onrender.com
# WEBHOOK_PATH=/telegram/webhook

# Секрет в заголовке X-Telegram-Bot-Api-Secret-Token: путь вебхука виден
# в логах прокси, без секрета подделать апдейт может кто угодно.
# Пусто — выводится из токена бота.
# WEBHOOK_SECRET=

# Порт задаёт хостинг сам (PORT). Локально трогать не нужно.
# PORT=10000

# На хостинге вместо SQLite — внешний бесплатный Postgres (Neon, Supabase):
# диск на free-тарифах эфемерный, файл БД исчезает при каждом деплое.
# Строку из панели можно вставлять как есть, в формате psycopg:
# postgres://... и ?sslmode=require бот приводит к asyncpg сам.
# DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ/ИМЯ_БАЗЫ?sslmode=require
